# thermio-gateway 环境变量样例（SEC-KEY-06：占位值，复制为 .env 后按现场改）
# .env 不入库（.gitignore）；生产凭据走 M1 §3.9 凭证发放流程。

# ── MQTT 上行（M1 登记产物：MQTT_CLIENT_ID 与 GATEWAY_SERIAL 须同源于同一 gateway 行）──
MQTT_BROKER_URL=mqtt://broker.example.local:1883
# 生产为 mqtts://...:8883 + 自签 CA（显式信任链，不关校验 SEC-NET-01/04）
MQTT_CA_PATH=
MQTT_USERNAME=SWGW-BLDG-A-01@tenant-a
MQTT_PASSWORD=change-me-device-secret
MQTT_CLIENT_ID=gw-xxxxxxxxxxxxxxxx
GATEWAY_SERIAL=SWGW-BLDG-A-01

# ── BACnet 本机身份（device-id 由 BA 厂商分配段，doctor 启动自检冲突 §9.4）──
BACNET_DEVICE_ID=52001
BACNET_PORT=47808
# 绑定网口 IP（可达 BA VLAN 的那张网卡，可选 /掩码 形式，如 192.168.10.5/24）
BACNET_INTERFACE=0.0.0.0
BACNET_APDU_TIMEOUT_MS=3000
BACNET_APDU_RETRIES=1
BACNET_MAX_INFLIGHT_PER_DEVICE=2
BACNET_INTER_REQUEST_GAP_MS=50

# ── 采集与缓存（gateway.md §4.4/§6/§11）──
POLL_DEFAULT_INTERVAL_S=60
CACHE_PATH=/var/lib/thermio-gateway/cache.db
CACHE_RETENTION_DAYS=4
REPLAY_INFLIGHT_MSGS=4
REPLAY_BATCH_POINTS=500

# ── 断链安全值触发窗（§7.4）──
OFFLINE_ACTION_DELAY_S=60

# ── 可观测（§10）──
METRICS_ADDR=0.0.0.0:9101
LOG_LEVEL=INFO
LOG_FILE=
